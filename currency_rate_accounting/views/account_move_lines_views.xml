<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_line_form_inherit_usd_rate" model="ir.ui.view">
        <field name="name">account.move.line.form.inherit.usd.rate</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account_accountant.view_move_line_form"/>
        <field name="arch" type="xml">
            <field name="debit" position="after">
                <field name="currency_rate_enabled" invisible="1"/>
                <field name="usd_rate" optional="show" modifiers="{'invisible': [('currency_rate_enabled', '=', False)]}"/>
                <field name="debito_usd" optional="show" modifiers="{'invisible': [('currency_rate_enabled', '=', False)]}"/>
                <field name="credito_usd" optional="show" modifiers="{'invisible': [('currency_rate_enabled', '=', False)]}"/>
                <field name="balance_usd" optional="show" modifiers="{'invisible': [('currency_rate_enabled', '=', False)]}"/>
            </field>
        </field>
    </record>

    <record id="view_move_line_tree_inherit_usd_rate" model="ir.ui.view">
        <field name="name">account.move.line.tree.inherit.usd.rate</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account_accountant.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="balance" position="after">
                <field name="currency_rate_enabled" invisible="1"/>
                <field name="usd_rate" optional="show" modifiers="{'invisible': [('currency_rate_enabled', '=', False)]}"/>
                <field name="debito_usd" optional="show" modifiers="{'invisible': [('currency_rate_enabled', '=', False)]}"/>
                <field name="credito_usd" optional="show" modifiers="{'invisible': [('currency_rate_enabled', '=', False)]}"/>
                <field name="balance_usd" optional="show" modifiers="{'invisible': [('currency_rate_enabled', '=', False)]}"/>
            </field>
        </field>
    </record>
</odoo>
