<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_currency_rate" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.currency.rate</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='account']//div[hasclass('o_settings_container')][.//field[@name='group_multi_currency']]" position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="currency_rate_accounting_enabled"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="currency_rate_accounting_enabled"/>
                        <div class="text-muted">
                            Habilitar módulo Currency Rate Accounting
                        </div>
                        <div class="mt-2" modifiers="{'invisible': [('currency_rate_accounting_enabled', '=', False)]}">
                            <button name="recalculate_usd_amounts" 
                                    type="object" 
                                    string="Recalcular Montos USD" 
                                    class="btn btn-secondary"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
