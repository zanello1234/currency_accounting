<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_rate_display" model="ir.ui.view">
        <field name="name">account.move.form.inherit.rate.display</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <label for="usd_rate" string="Tasa de cambio del día" 
                       attrs="{'invisible': [('currency_id', '=', False)]}"/>
                <div name="usd_rate_div" class="o_row"
                     attrs="{'invisible': [('currency_id', '=', False)]}">
                    <field name="usd_rate" 
                           readonly="1" 
                           force_save="1"
                           widget="float"
                           digits="[12,6]"/>
                    <button name="action_open_currency_rate" 
                            type="object" 
                            string="Editar Tasa" 
                            class="oe_link"/>
                </div>
            </field>
        </field>
    </record>

    <record id="view_move_tree_inherit_rate" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.rate</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="usd_rate" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
